# ===========================================
# Lakehouse raw data exclusions
# Keep: CSV, JSON, descriptors, digitized GIWAXS data
# Ignore: PDFs, images, raw figure files
# ===========================================

# Literature PDFs (copyright + large)
raw/literature/papers/

# Cropped figures & images (not needed in repo)
raw/literature/fig_crops/
raw/literature/giwaxs_images/
raw/literature/figures/
raw/literature/images/
raw/literature/imgs/

# Optional: raw digitizer exports (keep only standard CSV)
raw/literature/raw_digitizer_exports/

# ===========================================
# Computed data exclusions (optional)
# Comment out if you want to track geometry XYZ files.
# ===========================================
# raw/computed/geometry_xyz/

# ===========================================
# Unity Generated Files (if Unity project added later)
# These SHOULD NOT be in Git.
# ===========================================
*.meta
Library/
Temp/
Logs/
Obj/
Build/
Builds/
UserSettings/
MemoryCaptures/

# ===========================================
# Misc
# ===========================================
*.DS_Store